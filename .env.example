# Gateway
TOKENPULSE_GATEWAY_PORT=8788
TOKENPULSE_GATEWAY_TOKEN=dev-local-token
TOKENPULSE_MOCK_UPSTREAM=1

# Upstream (operator-only — never commit real values)
# TOKENPULSE_MOCK_UPSTREAM=0
# TOKENPULSE_UPSTREAM_BASE_URL=https://api.openai.com/v1
# TOKENPULSE_UPSTREAM_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# TOKENPULSE_UPSTREAM_TIMEOUT_MS=20000

# Policy
# TOKENPULSE_BUDGETS_PATH=./budgets.example.json
# TOKENPULSE_DEFAULT_DAILY_USD=25
# TOKENPULSE_DEFAULT_MONTHLY_USD=400

# TOKENPULSE_MODELS_PATH=./models.example.json
# TOKENPULSE_MODEL_ALLOW=gpt-4o-mini,gpt-4o
# TOKENPULSE_MODEL_DENY=gpt-4

# Admin / dashboard share the gateway token and bind.

# Sensitive heuristics (default on). Set off to disable.
# TOKENPULSE_SENSITIVE=on
# TOKENPULSE_SENSITIVE_EXTRA=internal-codename;;project-x

# Rate limits (requests per window per team). Missing = unlimited.
# TOKENPULSE_RATES_PATH=./rates.example.json
# TOKENPULSE_DEFAULT_RPM=
# TOKENPULSE_RATE_WINDOW_MS=60000

# Ledger (jsonl default; sqlite optional)
# TOKENPULSE_LEDGER_DIR=./data/ledger
# TOKENPULSE_LEDGER_DRIVER=jsonl
# TOKENPULSE_LEDGER_DRIVER=sqlite
# TOKENPULSE_SQLITE_PATH=./data/ledger.sqlite
