{
  "name": "tokenpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Private AI FinOps + shadow-AI control plane for enterprises",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "demo": "bash demo.sh",
    "start:gateway": "tsx src/gateway.ts",
    "summary": "tsx src/cli.ts --summary",
    "export-ledger": "tsx src/cli.ts --export",
    "export-finops": "tsx src/cli.ts --export-finops",
    "export-security": "tsx src/cli.ts --export-security",
    "verify-ledger": "tsx src/cli.ts --verify-ledger",
    "issue-key": "tsx src/cli.ts --issue-key",
    "revoke-key": "tsx src/cli.ts --revoke-key",
    "enable-key": "tsx src/cli.ts --enable-key",
    "rotate-key": "tsx src/cli.ts --rotate-key",
    "list-keys": "tsx src/cli.ts --list-keys",
    "alerts": "tsx src/cli.ts --alerts",
    "recording-prep": "tsx src/cli.ts --recording-prep",
    "outreach-snippet": "tsx src/cli.ts --outreach-snippet",
    "buyer-brief": "tsx src/cli.ts --buyer-brief",
    "annual-avoided": "tsx src/cli.ts --annual-avoided",
    "demo:seeded": "TOKENPULSE_LEDGER_DIR=data/ledger-seed tsx src/cli.ts --seed-demo && TOKENPULSE_MOCK_UPSTREAM=1 TOKENPULSE_GATEWAY_TOKEN=dev-local-token TOKENPULSE_LEDGER_DIR=data/ledger-seed tsx src/gateway.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
